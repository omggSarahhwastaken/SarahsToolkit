[{"description":"Your personal temp folder.","id":"temp.user","name":"User temp files","paths":["%TEMP%\\*"],"quickClean":true},{"description":"System-wide temp folder.","id":"temp.windows","name":"Windows temp files","paths":["%WINDIR%\\Temp\\*"],"quickClean":true},{"description":"Downloaded update files that are no longer needed.","id":"update.cache","name":"Windows Update cache","paths":["%WINDIR%\\SoftwareDistribution\\Download\\*"],"quickClean":false},{"description":"Peer-to-peer update sharing cache.","id":"delivery.opt","name":"Delivery Optimization cache","paths":["%WINDIR%\\SoftwareDistribution\\DeliveryOptimization\\*"],"quickClean":false},{"description":"Empties the Recycle Bin.","id":"recycle.bin","name":"Recycle Bin","paths":[],"quickClean":true,"special":"recyclebin"},{"description":"Chrome, Edge and Firefox caches. Browsing history is kept.","id":"browser.cache","name":"Browser caches","paths":["%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Cache\\*","%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Code Cache\\*","%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Cache\\*","%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Code Cache\\*","%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2\\*"],"quickClean":true},{"description":"DirectX and GPU vendor shader caches. They regenerate automatically.","id":"shader.cache","name":"Shader & GPU caches","paths":["%LOCALAPPDATA%\\D3DSCache\\*","%LOCALAPPDATA%\\NVIDIA\\DXCache\\*","%LOCALAPPDATA%\\NVIDIA\\GLCache\\*","%LOCALAPPDATA%\\AMD\\DxCache\\*"],"quickClean":true},{"description":"Old CBS and DISM log files.","id":"windows.logs","name":"Windows log bloat","paths":["%WINDIR%\\Logs\\CBS\\*.log","%WINDIR%\\Logs\\CBS\\*.cab","%WINDIR%\\Logs\\DISM\\*.log"],"quickClean":false}]