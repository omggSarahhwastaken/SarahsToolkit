[
    {
        "description": "Safe everyday improvements: less telemetry and background activity, snappier menus and windows. Nothing here changes how games or apps behave.",
        "id": "balanced",
        "name": "Balanced",
        "tweaks": [
            "privacy.telemetry",
            "privacy.advertisingId",
            "privacy.tailoredExperiences",
            "perf.menuDelay",
            "perf.startupDelay",
            "perf.transparency",
            "perf.animations",
            "privacy.silentInstalls",
            "privacy.consumerExperience",
            "perf.deliveryOpt"
        ]
    },
    {
