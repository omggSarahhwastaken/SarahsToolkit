    },
    {
        "id": "battery-saver",
        "name": "Battery Saver",
        "description": "For laptops on the go: quiets background apps and animations, and undoes the performance tweaks that cost battery \u2014 CPU power throttling and background disk activity.",
        "tweaks": [
            "privacy.backgroundApps",
            "perf.transparency",
            "perf.animations"
        ],
        "revert": [
            "perf.powerThrottling",
            "perf.sysMain",
            "perf.prefetch",
            "perf.lastAccess",
            "gaming.hwScheduling",
            "power.coreParking",
            "power.pcieAspm",
            "power.usbSuspend",
            "power.wifiPerf",
            "power.ultimatePerf"
        ]
    },
    {
        "id": "stock",
        "name": "Stock Windows",
        "description": "The panic button: reverts every tweak back to Windows defaults.",
        "revertAll": true
    }
]
