<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SarahsToolkit</AssemblyName>
    <RootNamespace>SarahsToolkit</RootNamespace>
    <Version>2.8.5</Version>
    <Product>Sarah's Toolkit</Product>
    <Description>Sarah's Toolkit - Windows cleanup, debloat and optimization</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WFAC010 is suppressed, not ignored: the DPI settings live in
         app.manifest (finding 2) because a custom manifest is required
         for requireAdministrator, and ApplicationHighDpiMode is only an
         analyzer-visible property — with a custom manifest it changes
         nothing in the built exe (verified: no dpiAware in the binary).
         The manifest is the only route that actually applies. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <Content Include="Data\tweaks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\debloat.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\cleanup.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\services.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\presets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\game_releases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\frames\stage1.png" />
    <Resource Include="Assets\frames\stage2.png" />
    <Resource Include="Assets\frames\stage3.png" />
    <Resource Include="Assets\frames\stage4.png" />
    <Resource Include="Assets\frames\stage5.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Minecraft-Regular.otf" />
    <Resource Include="Fonts\Minecraft-Italic.otf" />
    <Resource Include="Fonts\Minecraft-Bold.otf" />
    <Resource Include="Fonts\Minecraft-BoldItalic.otf" />
  </ItemGroup>

</Project>
