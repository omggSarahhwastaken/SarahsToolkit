                            <Button Content="Payload test" Width="110" Margin="0,0,8,0" Click="DevPayloadCheck_Click"/>
                            <Button Content="Vitals/health test" Width="130" Margin="0,0,8,0" Click="DevVitalsHealth_Click"/>
                            <Button Content="Environment check" Width="130" Click="DevEnvCheck_Click"/>
                            <Button Content="Copy log" Width="80" Margin="8,0,0,0" Click="CopyDevLog_Click"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource Muted12}"
                                   Text="Validation suite for the app itself: data files, the update pipeline, and the runtime environment. Nothing here changes your system."/>
                        <ListBox x:Name="DevLog"/>
                    </DockPanel>
                </Grid>

                <!-- ======== About ======== -->
                <Grid x:Name="PageAbout" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
                            <Border Width="64" Height="64" CornerRadius="18" Background="#1E1E26"
                                    BorderBrush="{StaticResource DkAccentBrush}" BorderThickness="2"
                                    HorizontalAlignment="Left" Margin="0,0,0,16">
                                <TextBlock Text="S" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource DkAccentHoverBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sarah's Toolkit" FontSize="28"
                                       FontFamily="{StaticResource McFont}" FontWeight="Bold" FontStyle="Italic"/>
                            <TextBlock x:Name="VersionText" Margin="0,4,0,12"
                                       Foreground="{StaticResource DkMutedBrush}" Text="v1.3.0"/>
                            <TextBlock TextWrapping="Wrap"
                                       Text="Windows cleanup, debloat and optimization. Sidebar-driven, data-driven, and safe by default."/>
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource Muted12}"
                                       Text="Runs as administrator. Helper scripts are generated to a temp file, run once, and deleted - nothing is logged or left behind. The debloat list and cleanup behavior are derived from Sarah's Optimizer."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
                            <GroupBox Header="Appearance" Margin="0,0,0,12" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Interface scale" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,2,0,6" TextWrapping="Wrap" Style="{StaticResource Muted12}"
                                               Text="Scales the whole interface up or down. Takes effect immediately."/>
                                    <ComboBox x:Name="SettingsScaleCombo" Width="160" HorizontalAlignment="Left"
                                              SelectionChanged="SettingsScale_Changed">
                                        <ComboBoxItem Content="80%"/>
                                        <ComboBoxItem Content="90%"/>
                                        <ComboBoxItem Content="100%"/>
                                        <ComboBoxItem Content="110%"/>
                                        <ComboBoxItem Content="125%"/>
                                        <ComboBoxItem Content="150%"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Behavior" Margin="0,0,0,12" Padding="10">
                                <StackPanel>
                                    <CheckBox x:Name="SettingsTrayCheck" Margin="0,2,0,8"
                                              Content="Minimize to tray when closing the window"
                                              Checked="SettingsFlag_Changed" Unchecked="SettingsFlag_Changed"/>
                                    <CheckBox x:Name="SettingsUpdatesCheck" Margin="0,2,0,8"
                                              Content="Check for updates on launch"
                                              Checked="SettingsFlag_Changed" Unchecked="SettingsFlag_Changed"/>
                                    <CheckBox x:Name="SettingsStartupCheck" Margin="0,2,0,8"
                                              Content="Start with Windows"
                                              Checked="SettingsStartup_Changed" Unchecked="SettingsStartup_Changed"/>
                                    <TextBlock Text="Open on" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <ComboBox x:Name="SettingsDefaultPageCombo" Width="200" HorizontalAlignment="Left"
                                              SelectionChanged="SettingsDefaultPage_Changed">
                                        <ComboBoxItem Content="Home"/>
                                        <ComboBoxItem Content="Last page I used"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Performance tracker" Margin="0,0,0,12" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Temperature unit" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="SettingsTempCombo" Width="160" HorizontalAlignment="Left"
                                              Margin="0,4,0,0" SelectionChanged="SettingsTemp_Changed">
                                        <ComboBoxItem Content="Celsius"/>
                                        <ComboBoxItem Content="Fahrenheit"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Data" Margin="0,0,0,12" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open settings folder" Margin="0,0,8,0"
                                                Click="SettingsOpenFolder_Click"/>
                                        <Button Content="Reset all settings" Click="SettingsReset_Click"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Muted12}"
                                               Text="Settings live in a single settings.json file. The only log is the performance tracker log, capped at 150 MB."/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Storage" Margin="0,0,0,12" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="SettingsStorageText" TextWrapping="Wrap" Style="{StaticResource Muted12}"
                                               Text="Measuring…"/>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Muted12}"
                                               Text="The whole app — program files, settings and logs — is designed to stay far under 1 GB."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>

            <!-- Status bar -->
            <StatusBar Grid.Row="2">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Ready"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <!-- ============ Right rail: upcoming game releases ============ -->
        <Border Grid.Column="2" Background="{StaticResource DkRailBrush}"
                BorderBrush="{StaticResource DkCardBorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10">
                    <TextBlock Text="Upcoming releases" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GameFeedCount" FontSize="11"
                               Foreground="{StaticResource DkMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GameFeedPanel" Margin="14,0,14,14"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
