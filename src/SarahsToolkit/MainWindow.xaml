<Window x:Class="SarahsToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stk="clr-namespace:SarahsToolkit.Controls"
        Title="Sarah's Toolkit" Height="700" Width="1340"
        MinWidth="1120" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DkBgBrush}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ============ VRCX-style icon rail ============ -->
        <Border Grid.Column="0" Background="{StaticResource DkRailBrush}"
                BorderBrush="{StaticResource DkCardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Width="44" Height="44" CornerRadius="12"
                        Background="#1E1E26" BorderBrush="{StaticResource DkAccentBrush}"
                        BorderThickness="1.5" Margin="0,12,0,6" HorizontalAlignment="Center">
                    <TextBlock Text="S" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DkAccentHoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="TOOLKIT" FontSize="9"
                           Foreground="{StaticResource DkMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"
                           FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="RailVersionText" Text="v1.3.0"
                           FontSize="10" Foreground="{StaticResource DkMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavRailButton}"
                                     Content="Home" Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavHealth" Style="{StaticResource NavRailButton}"
                                     Content="Health" Tag="&#xEB51;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCleanup" Style="{StaticResource NavRailButton}"
                                     Content="Cleanup" Tag="&#xE74D;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDebloat" Style="{StaticResource NavRailButton}"
                                     Content="Debloat" Tag="&#xE711;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavServices" Style="{StaticResource NavRailButton}"
                                     Content="Services" Tag="&#xE7C4;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavOptimize" Style="{StaticResource NavRailButton}"
                                     Content="Optimize" Tag="&#xE72C;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPresets" Style="{StaticResource NavRailButton}"
                                     Content="Presets" Tag="&#xE734;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCustomize" Style="{StaticResource NavRailButton}"
                                     Content="Customize" Tag="&#xE70F;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource NavRailButton}"
                                     Content="Network" Tag="&#xE774;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSecurity" Style="{StaticResource NavRailButton}"
                                     Content="Security" Tag="&#xE83D;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavRailButton}"
                                     Content="Tools" Tag="&#xE90F;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDev" Style="{StaticResource NavRailButton}"
                                     Content="Dev" Tag="&#xE73E;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavRailButton}"
                                     Content="About" Tag="&#xE946;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavRailButton}"
                                     Content="Settings" Tag="&#xE713;" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Main column ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource DkBgBrush}"
                    BorderBrush="{StaticResource DkCardBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,14,20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Home" FontSize="20"
                                   FontFamily="{StaticResource McFont}" FontStyle="Italic"/>
                        <TextBlock x:Name="PageSubtitle" Text="System overview" FontSize="12"
                                   Foreground="{StaticResource DkMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="#4CAF50" Margin="0,0,8,0"
                                 ToolTip="Update status"/>
                        <TextBlock x:Name="UpdateLabel" Text="Up to date" FontSize="12"
                                   Foreground="{StaticResource DkMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pages -->
            <Grid Grid.Row="1" x:Name="PageHost" Background="{StaticResource DkBgBrush}">

                <!-- ======== Dashboard ======== -->
                <Grid x:Name="PageDashboard" Visibility="Visible">
                    <ScrollViewer>
                        <StackPanel Margin="20">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock x:Name="HealthScoreNum" Text="…" FontSize="40" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="/100" FontSize="13" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="HealthScoreLabel" Text="PC HEALTH" FontSize="11"
                                                       Foreground="{StaticResource DkMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="HealthScoreSub" Text="Checking…" FontSize="12"
                                                   Foreground="{StaticResource DkMutedBrush}" Margin="0,0,0,6"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel x:Name="HealthFixesPanel"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource H2}" Text="System overview"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="DashRefresh" Content="Refresh" Width="90"
                                        Click="DashRefresh_Click"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Rows="3">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DashCpuDot" Width="10" Height="10" Fill="#4CAF50"
                                                 VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="DashCpu" Text="…" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DashGpuDot" Width="10" Height="10" Fill="#4CAF50"
                                                 VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="DashGpu" Text="…" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DashDiskDot" Width="10" Height="10" Fill="#4CAF50"
                                                 VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="DISK (C:)" FontSize="11" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="DashDisk" Text="…" FontSize="14" FontWeight="SemiBold"/>
                                            <ProgressBar x:Name="DashDiskBar" Style="{StaticResource RoundProgress}"
                                                         Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100"/>
                                            <TextBlock x:Name="DashDiskSub" FontSize="11"
                                                       Foreground="{StaticResource DkMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DashUptimeDot" Width="10" Height="10" Fill="#42A5F5"
                                                 VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UPTIME" FontSize="11" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="DashUptime" Text="…" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DashBuild" FontSize="11"
                                                       Foreground="{StaticResource DkMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DashRebootDot" Width="10" Height="10" Fill="#4CAF50"
                                                 VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="REBOOT" FontSize="11" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="DashReboot" Text="…" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource DkMutedBrush}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Text="Pending restarts can block updates and tweaks."/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="VitalRamDot" Width="8" Height="8" Fill="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="MEMORY" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VitalRamVal" Grid.Column="1" Text="…"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="VitalRamPct" Text="" FontSize="10"
                                                   Foreground="{StaticResource DkMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                        <stk:Sparkline x:Name="VitalRamGraph" Height="44" LineColor="#4CAF50"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DashBootDot" Width="10" Height="10" Fill="#4CAF50"
                                                 VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="BOOT TIME" FontSize="11" Foreground="{StaticResource DkMutedBrush}"/>
                                            <TextBlock x:Name="DashBoot" Text="…" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="DashBootSub" FontSize="11"
                                                       Foreground="{StaticResource DkMutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <TextBlock Text="LIVE VITALS" FontSize="11"
                                           Foreground="{StaticResource DkMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="updates every second" FontSize="11"
                                           Foreground="{StaticResource DkMutedBrush}"
                                           VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Rows="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="VitalCpuDot" Width="8" Height="8" Fill="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="CPU" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VitalCpuVal" Grid.Column="1" Text="…"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <stk:Sparkline x:Name="VitalCpuGraph" Height="44" LineColor="#8B5CF6"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="VitalGpuCard" Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="VitalGpuDot" Width="8" Height="8" Fill="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="GPU" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VitalGpuVal" Grid.Column="1" Text="…"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <stk:Sparkline x:Name="VitalGpuGraph" Height="44" LineColor="#22D3EE"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="VitalDiskDot" Width="8" Height="8" Fill="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="DISK" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VitalDiskVal" Grid.Column="1" Text="…"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <stk:Sparkline x:Name="VitalDiskGraph" Height="44" LineColor="#FFA726"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="VitalNetDot" Width="8" Height="8" Fill="#42A5F5"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="NETWORK" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VitalNetVal" Grid.Column="1" Text="…"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <stk:Sparkline x:Name="VitalNetGraph" Height="44" LineColor="#42A5F5" AutoScale="True"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="VitalPingDot" Width="8" Height="8" Fill="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="PING" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VitalPingVal" Grid.Column="1" Text="…"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <stk:Sparkline x:Name="VitalPingGraph" Height="44" LineColor="#EF5350" AutoScale="True"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,12,0,12">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="TOP MEMORY USAGE" FontSize="11"
                                                   Foreground="{StaticResource DkMutedBrush}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="TopMemPanel">
                                            <TextBlock Text="…" Style="{StaticResource Muted12}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="TOP CPU USAGE" FontSize="11"
                                                   Foreground="{StaticResource DkMutedBrush}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="TopCpuPanel">
                                            <TextBlock Text="…" Style="{StaticResource Muted12}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TOP GPU USAGE" FontSize="11"
                                                   Foreground="{StaticResource DkMutedBrush}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="TopGpuPanel">
                                            <TextBlock Text="…" Style="{StaticResource Muted12}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border x:Name="RebootBanner" Style="{StaticResource Card}" Visibility="Collapsed"
                                    BorderBrush="#FFA726" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#FFA726" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                        <Run Text="A restart is pending. "/>
                                        <Run Text="Reboot Windows so updates and tweaks take full effect."
                                             Foreground="{StaticResource DkMutedBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource H2}" Text="Quick actions" Margin="0,4,0,12"/>
                            <WrapPanel>
                                <Button x:Name="DashQuickClean" Content="Quick Clean" Width="130"
                                        Margin="0,0,10,10" Style="{StaticResource AccentButton}"
                                        Click="DashQuickClean_Click"/>
                                <Button x:Name="DashFullClean" Content="Full Clean" Width="130"
                                        Margin="0,0,10,10" Click="DashFullClean_Click"/>
                                <Button x:Name="DashSpeedTest" Content="Speed test" Width="130"
                                        Margin="0,0,10,10" Click="DashSpeedTest_Click"/>
                                <Button x:Name="DashDebloat" Content="Review bloatware" Width="140"
                                        Margin="0,0,10,10" Click="DashDebloat_Click"/>
                                <Button x:Name="DashCheckUpdates" Content="Check for updates" Width="140"
                                        Margin="0,0,10,10" Click="CheckUpdates_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ======== Health ======== -->
                <Grid x:Name="PageHealth" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Margin="20">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HealthBatteryDot" Width="10" Height="10" Fill="#4CAF50"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="BATTERY" FontSize="11"
                                                       Foreground="{StaticResource DkMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HealthBatteryPct" Grid.Column="1" Text="…"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel x:Name="HealthBatteryFacts">
                                        <ProgressBar x:Name="HealthBatteryBar" Style="{StaticResource RoundProgress}"
                                                     Height="8" Margin="0,2,0,10" Minimum="0" Maximum="100"/>
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Design capacity" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"/>
                                                <TextBlock x:Name="HealthBatteryDesign" Text="…" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Full charge now" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"/>
                                                <TextBlock x:Name="HealthBatteryFull" Text="…" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Cycle count" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"/>
                                                <TextBlock x:Name="HealthBatteryCycles" Text="…" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Charge" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"/>
                                                <TextBlock x:Name="HealthBatteryCharge" Text="…" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <TextBlock x:Name="HealthBatteryEmpty" Visibility="Collapsed"
                                               Style="{StaticResource Muted12}" TextWrapping="Wrap"
                                               Text="No battery detected — this looks like a desktop."/>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="STORAGE HEALTH" FontSize="11"
                                                   Foreground="{StaticResource DkMutedBrush}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="HealthDisksPanel">
                                            <TextBlock Text="…" Style="{StaticResource Muted12}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="HealthUpdatesDot" Width="10" Height="10" Fill="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="WINDOWS UPDATE" FontSize="11"
                                                           Foreground="{StaticResource DkMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="HealthUpdatesVal" Text="…" FontSize="16"
